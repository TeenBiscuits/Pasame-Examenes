---
import { getTranslations, langPath, type Lang } from "../lib/i18n";
import Reicon from "./Reicon.astro";

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="border-border bg-surface-alt text-fg-muted border-t pt-5 pb-[calc(1.25rem+env(safe-area-inset-bottom))] text-sm">
  <div class="mx-auto max-w-6xl px-4">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <p class="max-w-3xl leading-relaxed text-pretty">
        <a href={langPath(lang)} class="text-fg hover:text-accent-fg rounded font-semibold underline-offset-4 hover:underline">Pásame Exámenes</a>
        <span> © {year} {t.footer.by} </span>
        <a href="https://pablopl.dev" class="text-fg-secondary hover:text-accent-fg rounded underline-offset-4 hover:underline">Pablo Portas López</a>
        <span> {t.footer.contentIsLicensedUnder} </span>
        <a href="https://creativecommons.org/licenses/BY-SA/4.0/" class="text-fg-secondary hover:text-accent-fg rounded underline-offset-4 hover:underline">CC BY-SA 4.0</a>.
      </p>
      <nav aria-label={t.footer.linksLabel} class="flex flex-wrap items-center justify-center gap-2 md:justify-end">
        <button type="button" data-dialog-open="licenses-dialog" class="text-fg-muted hover:bg-surface hover:text-fg inline-flex items-center gap-1 rounded-full px-2 py-1 text-xs font-medium underline-offset-4"><Reicon name="Copyright" size={14} aria-hidden="true" /> {t.footer.licenses}</button>
        <a href={langPath(lang, "/privacy")} rel="nofollow" class="text-fg-muted hover:bg-surface hover:text-fg inline-flex items-center gap-1 rounded-full px-2 py-1 text-xs font-medium"><Reicon name="ShieldCheck" size={14} aria-hidden="true" /> {t.footer.privacy}</a>
        <a href="https://github.com/TeenBiscuits/Pasame-Examenes" target="_blank" rel="noopener noreferrer" class="text-fg-muted hover:bg-surface hover:text-fg inline-flex items-center gap-1 rounded-full px-2 py-1 text-xs font-medium">GitHub <Reicon name="ArrowRightUp" size={13} weight="Filled" aria-hidden="true" /></a>
      </nav>
    </div>
  </div>
</footer>

<dialog id="licenses-dialog" closedby="any" class="modal-dialog modal-dialog--wide p-6" aria-labelledby="licenses-dialog-title">
  <form method="dialog">
    <div class="mb-5 flex items-center justify-between gap-4">
      <h2 id="licenses-dialog-title" class="text-fg text-xl font-semibold">{t.footer.licenseTitle}</h2>
      <button type="submit" class="text-fg-muted hover:text-fg inline-flex size-9 items-center justify-center rounded-lg" aria-label={t.footer.close}><Reicon name="XSquare" size={20} aria-hidden="true" /></button>
    </div>
    <p class="text-fg-secondary mb-4 max-w-prose text-sm leading-relaxed">{t.footer.licenseIntro}</p>
    <div class="grid gap-3 md:grid-cols-2">
      <a href="https://creativecommons.org/licenses/BY-SA/4.0/" target="_blank" rel="noopener noreferrer" class="border-border bg-surface-alt rounded-xl border-2 p-4">
        <strong class="text-fg block">CC BY-SA 4.0</strong>
        <span class="text-fg-secondary mt-2 block text-xs leading-relaxed">{t.footer.contentLicenseDescription}</span>
      </a>
      <a href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener noreferrer" class="border-border bg-surface-alt rounded-xl border-2 p-4">
        <strong class="text-fg block">Apache 2.0</strong>
        <span class="text-fg-secondary mt-2 block text-xs leading-relaxed">{t.footer.softwareLicenseDescription}</span>
      </a>
    </div>
  </form>
</dialog>
