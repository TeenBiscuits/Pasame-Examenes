{
  "name": "pasame-examenes",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "check:bones": "tsx scripts/check-bones.ts",
    "generate-content-stats": "tsx scripts/generate-question-summary-map.ts",
    "generate-og-images": "tsx scripts/generate-og-images.ts",
    "generate-build-assets": "pnpm run generate-content-stats && pnpm run generate-og-images",
    "predev": "pnpm run generate-build-assets",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "prebuild": "pnpm run check:bones && pnpm run generate-build-assets",
    "build": "vite build",
    "preview": "vite preview",
    "perf:preview": "SITE_URL=http://127.0.0.1:4173 pnpm preview --host 127.0.0.1 --port 4173",
    "perf:baseline": "unlighthouse --urls /es,/es/bede,/es/calculo/exam/2023-01,/es/deese/practice/intro-y-objetos,/es/esei/exam/2025-07,/es/iesede,/es/privacy",
    "perf:baseline:json": "unlighthouse-ci --urls /es,/es/bede,/es/calculo/exam/2023-01,/es/deese/practice/intro-y-objetos,/es/esei/exam/2025-07,/es/iesede,/es/privacy --reporter jsonExpanded",
    "perf:full": "unlighthouse --disable-dynamic-sampling",
    "perf:full:json": "unlighthouse-ci --disable-dynamic-sampling --reporter jsonExpanded",
    "pretypecheck": "pnpm run generate-content-stats",
    "typecheck": "tsc --noEmit",
    "readme": "tsx scripts/update-readme-subjects.ts",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0",
    "@blobatar/react": "^2.7.0",
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-hotkeys": "^0.14.5",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "appwrite": "^29.1.0",
    "blobatar": "^2.7.0",
    "boneyard-js": "^1.10.0",
    "cuelume": "^0.2.8",
    "driver.js": "^1.10.2",
    "katex": "^0.19.0",
    "nitro": "3.0.260903-beta",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "reicon-react": "^1.2.6",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-animations": "^1.0.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@napi-rs/canvas": "^1.0.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/intent": "^0.5.6",
    "@tanstack/react-hotkeys-devtools": "^0.10.9",
    "@tanstack/router-cli": "^1.167.45",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript6": "npm:typescript@^6.0.3",
    "unlighthouse": "0.19.1",
    "vite": "^8.3.4",
    "vite-imagetools": "^12.0.1"
  },
  "intent": {
    "skills": [
      "@tanstack/*",
      "dotenv",
      "nostics"
    ]
  }
}
