{
  "name": "pasame-examenes",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "generate-content-stats": "tsx scripts/generate-question-summary-map.ts",
    "generate-og-images": "tsx scripts/generate-og-images.ts",
    "generate-build-assets": "pnpm run generate-content-stats && pnpm run generate-og-images",
    "predev": "pnpm run generate-build-assets",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "prebuild": "pnpm run generate-build-assets",
    "build": "vite build",
    "preview": "vite preview",
    "pretypecheck": "pnpm run generate-content-stats",
    "typecheck": "tsc --noEmit",
    "readme": "tsx scripts/update-readme-subjects.ts",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@fontsource-variable/cascadia-code": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "cuelume": "^0.2.2",
    "driver.js": "^1.8.0",
    "katex": "^0.18.4",
    "nitro": "3.0.260610-beta",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "reicon-react": "^1.2.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-animations": "^1.0.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@napi-rs/canvas": "^1.0.8",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.33",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-imagetools": "^12.0.0"
  }
